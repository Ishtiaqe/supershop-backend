[
  {
    "name": "keep-latest-backend-image",
    "action": {
      "type": "KEEP"
    },
    "mostRecentVersions": {
      "keepCount": 1,
      "packageNamePrefixes": [
        "supershop-backend/supershop-backend"
      ]
    }
  },
  {
    "name": "delete-old-images",
    "action": {
      "type": "DELETE"
    },
    "condition": {
      "tagState": "ANY",
      "olderThan": "1s"
    }
  }
]
