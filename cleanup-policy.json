[
  {
    "name": "delete-older-backend-images",
    "action": {
      "type": "Delete"
    },
    "condition": {
      "tagState": "ANY",
      "packageNamePrefixes": [
        "supershop-backend/supershop-backend"
      ],
      "olderThan": "1d"
    }
  },
  {
    "name": "keep-latest-backend-image",
    "action": {
      "type": "Keep"
    },
    "mostRecentVersions": {
      "packageNamePrefixes": [
        "supershop-backend/supershop-backend"
      ],
      "keepCount": 1
    }
  }
]
